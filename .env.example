NEXT_PUBLIC_CONVEX_URL=
SESSION_SECRET=
ENABLE_DEV_LOGIN=

# Public base URL of this app (used as WebAuthn relying party origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. When present (e.g. on Vercel), `npm run build` pushes Convex
# functions with `convex deploy --cmd "next build"` so the frontend and its
# backend deploy together. Generate a prod-scoped key from the Convex dashboard
# (Settings > Deploy Keys) or with:
#   npx convex deployment token create vercel-token --deployment prod
# CONVEX_DEPLOY_KEY=
